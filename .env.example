# Contact included in the User-Agent sent to regulators (the SEC requires one).
FEED_CONTACT_EMAIL=esg-compliance@yourfirm.com

# Look-back window for the live feed, in days.
FEED_LOOKBACK_DAYS=60

# Per-request timeout, in milliseconds.
FEED_TIMEOUT_MS=15000

# Optional: free token from https://www.courtlistener.com/sign-in/ (enables US court opinions).
COURTLISTENER_TOKEN=

# Optional: extra RSS/Atom feeds without code changes (JSON array).
# RSS_FEEDS=[{"id":"sg-mas","name":"MAS media releases","jurisdiction":"SG","url":"https://..."}]
RSS_FEEDS=

# Monthly RSS refresh (first Friday of each month).
# Secret the scheduler must send as "Authorization: Bearer <CRON_SECRET>". Required in production;
# Vercel Cron sends it automatically when this variable is set in the project.
CRON_SECRET=
# Timezone used to decide what counts as the "first Friday" (IANA name).
FEED_TIMEZONE=Asia/Singapore
